# npm 11 refuses two optional peer chains that aren't real conflicts:
# - @hookform/resolvers lists every validation library as an optional peer, through @typeschema/zod (Zod 3);
# - openapi-typescript 7.13 declares TypeScript ^5, and it works with the TypeScript 6 we use.
# Peers we need are listed in package.json directly. Docker's `npm ci` reads this file too.
legacy-peer-deps=true
