{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "backend.app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "private",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-project",
        "python",
        "-m",
        "http.server",
        "8123",
        "--bind",
        "127.0.0.1",
        "--directory",
        "private"
      ],
      "port": 8123
    }
  ]
}