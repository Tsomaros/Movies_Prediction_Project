# Secrets
.env

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Notebooks
.ipynb_checkpoints/

# Raw TMDB pull: large, and TMDB terms limit caching to six months
data/raw/

# Audit holdout: films of 2026 (same TMDB terms); `uv run python -m ml.data.pull --years 2026 --out-dir data/holdout_2026`
data/holdout_2026/

# Built from the raw pull (same TMDB terms); rebuild with `make db`
data/movies.db*
data/fresh*.db

# MiniLM model files (about 90 MB); download with `make model`
ml/artifacts/minilm/

# Trained LightGBM models (about 33 MB, change on every retrain); rebuild with `make train`.
# Their settings, calibration and metadata (*.json) are committed.
ml/artifacts/*.joblib
ml/artifacts/final/*.joblib

# Comparable-films index (about 26 MB, TMDB data); rebuild with `uv run python -m ml.explain.comparables`
ml/artifacts/final/comparables.npz

# Overview embedding cache (about 120 MB, TMDB text); rebuilt by `make features`
data/overview_embeddings*.npz

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Docker build inputs made by scripts/slim_db.py
build/

# Day 16: demo script, Q&A notes and the summary PDF, never committed
private/

# V1.5 backup of the v1 models (restored on rollback)
ml/artifacts.pre_v15/

# Spike outputs (logs, pulls, pickles) and local Claude Code settings
spikes/
.claude/
