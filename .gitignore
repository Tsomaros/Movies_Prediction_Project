# Secrets
.env

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Notebooks
.ipynb_checkpoints/

# Raw TMDB pull: large, and TMDB terms limit caching to six months
data/raw/

# Built from the raw pull (same TMDB terms); rebuild with `make db`
data/movies.db*

# MiniLM model files (about 90 MB); download with `make model`
ml/artifacts/minilm/

# Trained LightGBM models (about 33 MB, change on every retrain); rebuild with `make train`.
# Their settings, calibration and metadata (*.json) are committed.
ml/artifacts/*.joblib
ml/artifacts/final/*.joblib

# Overview embedding cache (about 120 MB, TMDB text); rebuilt by `make features`
data/overview_embeddings*.npz

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
