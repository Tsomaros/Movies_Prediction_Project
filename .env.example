# Copy this file to .env and paste your TMDB API Read Access Token (v4).
# themoviedb.org -> Settings -> API -> "API Read Access Token"
TMDB_READ_TOKEN=

# The demo account's database (Day 14). Live: Neon's connection string (Frankfurt, Postgres 18), e.g.
# postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=10
# Locally: the compose Postgres, postgresql://movies:movies@localhost:5432/movies
USER_DATABASE_URL=
# The demo account's password for the "Log in with password" link (the demo button needs none);
# make userdb hashes it into the database
DEMO_PASSWORD=
