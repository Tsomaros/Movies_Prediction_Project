# Build context for backend/Dockerfile (the app's one image): nothing goes in unless listed here.
*
!pyproject.toml
!uv.lock
!backend/
!ml/
!build/movies.db
!build/context.joblib
!frontend/

# Inside frontend/: the image installs its own packages and builds its own dist/
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/e2e/
frontend/test-results/
frontend/playwright-report/
frontend/Dockerfile
frontend/nginx.conf
frontend/**/*.log
frontend/**/*.local

# Inside the allowed folders, still out:
ml/artifacts/*.joblib
ml/artifacts/minilm/model.onnx
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ipynb_checkpoints/
backend/Dockerfile
